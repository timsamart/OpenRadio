{
  "name": "openradio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Greek live radio. Open. Tap. Listen.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:ingest": "node scripts/ingest.mjs",
    "catalog:health": "node scripts/health.mjs",
    "catalog:build": "node scripts/ingest.mjs && node scripts/health.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
